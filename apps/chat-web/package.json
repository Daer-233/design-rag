{
  "name": "design-rag-chat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-chat-safe.mjs",
    "build:direct": "vite build",
    "build:local": "powershell -ExecutionPolicy Bypass -File ../../scripts/build-chat-web.ps1",
    "clean:dist": "powershell -NoProfile -Command \"if (Test-Path dist) { [System.IO.Directory]::Delete((Resolve-Path dist).Path, \\$true) }\"",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
