# Application
APP_NAME=design-rag
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8030
LOG_LEVEL=INFO

# Service endpoints
EMBEDDING_SERVICE_URL=http://127.0.0.1:8031
RERANK_SERVICE_URL=http://127.0.0.1:8032

# Storage - keep large data outside C: drive
DATA_ROOT=I:\design-ai-data
MODEL_CACHE_DIR=I:\design-ai-data\models

# Future infrastructure configuration
POSTGRES_DSN=postgresql+psycopg://design_rag:REPLACE_ME@127.0.0.1:5432/design_rag
QDRANT_URL=http://127.0.0.1:6333
REDIS_URL=redis://127.0.0.1:6379/0
VECTOR_PROVIDER=qdrant

# External providers - add actual values only to .env, never commit secrets.
# This OpenAI-compatible LLM gateway is used only by explicit Step-6 actions.
LLM_BASE_URL=https://nowcoding.ai/v1
LLM_API_KEY=
LLM_MODEL_ID=gpt-5.6-terra
LLM_TIMEOUT_SECONDS=120
LLM_VISION_PROMPT_VERSION=design-image-v2-materials
# Safety limit for one explicitly approved external visual-analysis round.
LLM_VISION_BATCH_MAX_IMAGES=20
# Legacy aliases remain accepted as a fallback when LLM_API_KEY is blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
MODELSCOPE_CACHE=I:\design-ai-data\models\modelscope
POSTGRES_DB=design_rag
POSTGRES_USER=design_rag
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=I:\design-ai-data\postgres
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_DATA_DIR=I:\design-ai-data\qdrant
QDRANT_SNAPSHOTS_DIR=I:\design-ai-data\qdrant-snapshots
EMBEDDING_PORT=8031
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_MODEL_DIR=I:\design-ai-data\models\bge-m3
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_APP_NAME=design-rag-embedding
EMBEDDING_EAGER_LOAD=false
EMBEDDING_MODEL_REVISION=master
EMBEDDING_HOST=127.0.0.1
EMBEDDING_BATCH_SIZE=4
EMBEDDING_REQUEST_BATCH_SIZE=4
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=1
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANK_APP_NAME=design-rag-rerank
RERANK_EAGER_LOAD=true
RERANK_PORT=8032
RERANK_MODEL_DIR=I:\design-ai-data\models\bge-reranker-v2-m3
RERANK_MODEL_REVISION=master
RERANK_HOST=127.0.0.1
# Step 5 backend variables
QDRANT_COLLECTION=design_rag_chunks_v1
RETRIEVAL_RECALL_TOP_K=100
RETRIEVAL_COARSE_TOP_K=40
# Input budget for cross-encoder reranking; independent of final evidence count.
# Legacy RETRIEVAL_RERANK_TOP_K is used only when this key is absent.
RETRIEVAL_RERANK_CANDIDATE_TOP_K=8
RETRIEVAL_EVIDENCE_TOP_K=8
RETRIEVAL_MAX_EVIDENCE_PER_DOCUMENT=2
INFERENCE_TIMEOUT_SECONDS=360
# Step 6: MinerU Precision API v4. Keep the token only in .env.
MINERU_API_TOKEN=
# Defaults map to https://mineru.net/api/v4/file-urls/batch and
# https://mineru.net/api/v4/extract-results/batch/{batch_id}; only override for a different MinerU product.
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
# MinerU Precision API maximum input size: 200 MiB. Larger images route to GPT vision.
MINERU_PRECISION_MAX_FILE_BYTES=209715200
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=ch
# MinerU Precision API directly supports PDF, images, DOC/DOCX, PPT/PPTX and XLS/XLSX.
MINERU_SUPPORTED_EXTENSIONS=pdf,png,jpg,jpeg,jp2,webp,gif,bmp,doc,docx,ppt,pptx,xls,xlsx,html
MINERU_POLL_TIMEOUT_SECONDS=60
INGESTION_ALLOWED_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,png,jpg,jpeg,webp
INGESTION_MAX_UPLOAD_BYTES=536870912
# Scheduled import parsing. Nightly parsing follows Asia/Shanghai time.
# A scheduled batch only dispatches the MinerU/GPT tasks explicitly approved in Admin.
IMPORT_BATCH_SCHEDULE_RECONCILE_INTERVAL_SECONDS=15
IMPORT_BATCH_NIGHTLY_HOUR=19

EMBEDDING_LONG_TEXT_BATCH_CHARS=1800




# Remote OpenClaw evidence-only search API. Leave the token empty to keep the endpoint disabled.
# Generate a long random token and store it only on this host and the OpenClaw caller.
DESIGN_RAG_API_TOKEN=
DESIGN_RAG_API_PRINCIPAL_USER_ID=openclaw-readonly
# Comma-separated UUIDs that this token is allowed to search. Required when enabling the API.
# Deprecated and ignored. A valid bearer token can search any imported project.
DESIGN_RAG_API_ALLOWED_PROJECT_IDS=
# Comma-separated roles used to filter role-protected chunks. Keep empty unless required.
DESIGN_RAG_API_PRINCIPAL_ROLES=

# Anonymous local Agent (temporary no-login mode). Conversation history is isolated by
# a browser HttpOnly cookie; do not use IP addresses as user identities.
AGENT_ENABLED=true
AGENT_COOKIE_NAME=design_rag_anonymous_id
AGENT_MEMORY_MESSAGE_LIMIT=16
AGENT_EVENT_POLL_INTERVAL_SECONDS=0.1
AGENT_EVENT_HEARTBEAT_SECONDS=15
AGENT_STREAM_CHUNK_CHARS=36
AGENT_STREAM_CHUNK_INTERVAL_SECONDS=0.08
# Download once manually from ModelScope; subsequent Agent requests remain local-only.
AGENT_INTENT_MODEL_ID=Fengshenbang/Erlangshen-RoBERTa-110M-NLI
AGENT_INTENT_MODEL_REVISION=v1.0.0
# Keep BERT inference offline after the model is explicitly downloaded from ModelScope.
AGENT_INTENT_LOCAL_FILES_ONLY=true
AGENT_INTENT_MAX_LENGTH=256
# Read-only Node.js MCP gateway. Chat uses this endpoint to list projects and retrieve evidence.
DESIGN_RAG_MCP_ENABLED=true
DESIGN_RAG_MCP_URL=http://127.0.0.1:8040/mcp
DESIGN_RAG_MCP_TIMEOUT_SECONDS=360
DESIGN_RAG_MCP_HOST=0.0.0.0
DESIGN_RAG_MCP_PORT=8040

# Local-only PPT/PDF page rendering. Rendered JPG pages leave the host only after Admin approve_vision=true.
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
PDFTOPPM_PATH=C:\Users\liwj\.cache\codex-runtimes\codex-primary-runtime\dependencies\native\poppler\Library\bin\pdftoppm.exe
DOCUMENT_PAGE_VISION_ENABLED=true
DOCUMENT_PAGE_VISION_DPI=144
DOCUMENT_PAGE_VISION_MAX_PAGES=300
DOCUMENT_PAGE_RENDER_TIMEOUT_SECONDS=300
